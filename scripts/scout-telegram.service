[Unit]
Description=AI Agent Telegram Bot
After=network.target scout-api.service
Wants=scout-api.service

[Service]
Type=simple
User=abel
WorkingDirectory=/home/abel/scout
Environment="HOME=/home/abel"
EnvironmentFile=/home/abel/scout/.env
ExecStart=/home/abel/scout/venv/bin/python /home/abel/scout/shared/tools/telegram_bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
